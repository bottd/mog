    span:
      start: 2086
      end: 2109
      start_line: 80
      end_line: 80
  - kind: Paragraph
    children:
      - kind:
          Text: "Structural markers are used to give documents structure. These markers open the line they are used on, ignoring leading whitespace. Structural markers are repeated to explicitly indicate nesting. Using a heading "
      - kind:
          Delimiter: Verbatim
        children:
          - kind:
              Raw: "#"
      - kind:
          Text: " marker once is a top-level heading, two markers "
      - kind:
          Delimiter: Verbatim
        children:
          - kind:
              Raw: "##"
      - kind:
          Text: " represent a subheading and so on. These rules apply to all structural markers."
    span:
      start: 2111
      end: 2462
      start_line: 82
      end_line: 86
