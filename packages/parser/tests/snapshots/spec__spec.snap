                  Delimiter: Verbatim
              - kind:
                  Text: " "
              - kind:
                  Delimiter: Verbatim
                children:
                  - kind:
                      Raw: "|| verbatim        || Literal text        ||"
          - kind:
              Delimiter: TableCell
          - kind:
              Delimiter: TableCell
      - kind:
          Delimiter: TableRow
        children:
          - kind:
              Delimiter: TableCell
            children:
              - kind:
                  Delimiter: Verbatim
                children:
                  - kind:
                      Raw: ~~
          - kind:
              Delimiter: TableCell
            children:
