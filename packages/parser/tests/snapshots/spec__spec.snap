      start_line: 70
      end_line: 70
  - kind: Paragraph
    children:
      - kind:
          Text: "A backslash immediately preceding a delimiter or structural marker escapes it, rendering the delimiter or marker literal. A backslash in any other position is itself literal and requires no escaping."
    span:
      start: 1851
      end: 2050
      start_line: 72
      end_line: 74
  - kind:
