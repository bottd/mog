                  - kind:
                      Raw: "#|"
          - kind:
              Delimiter: TableCell
            children:
              - kind:
                  Text: table-header
          - kind:
              Delimiter: TableCell
            children:
              - kind:
                  Text: Table header
      - kind:
          Delimiter: TableRow
        children:
          - kind:
              Delimiter: TableCell
            children:
              - kind:
