  - kind: Paragraph
    children:
      - kind:
          Text: "All structural markers have a depth expressed through marker repetition. A repeated marker is one level deeper:"
  - kind:
      Delimiter: Verbatim
    attributes:
      - value: mog
    children:
      - kind:
          Raw: "# Heading 1"
      - kind:
          Raw: "## Heading 2"
      - kind:
          Raw: "### Heading 3"
  - kind: Paragraph
    children:
      - kind:
          Text: Depth is not used to nest nodes; containment is expressed through block syntax (
        children:
